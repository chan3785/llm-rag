LLAMA_SERVER_URL=http://localhost:8080
LLM_TIMEOUT_SECONDS=300
# Used when the client does not set max_tokens (stops runaway repetition)
LLM_MAX_TOKENS=1024

# Qdrant (docker compose up -d at the repo root)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=landmarks

# CLIP image embedding (changing the model requires re-ingesting with --recreate)
CLIP_MODEL=clip-ViT-L-14
# Landmark classification (tune with scripts/evaluate.py)
CLASSIFY_TOP_K=20
CLASSIFY_PER_LANDMARK=3
CLASSIFY_THRESHOLD=0.8

CORS_ORIGINS=["http://localhost:3000"]
