LLAMA_SERVER_URL=http://localhost:8080
LLM_TIMEOUT_SECONDS=300
# Generation defaults, used when the client does not set them
# (Qwen3-VL recommended vision settings + DRY; together they stop repetition loops)
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_PRESENCE_PENALTY=1.5
LLM_DRY_MULTIPLIER=0.8

# Qdrant (docker compose up -d at the repo root)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=landmarks

# CLIP image embedding (changing the model requires re-ingesting with --recreate)
CLIP_MODEL=clip-ViT-L-14
# Landmark classification (tune with scripts/evaluate.py)
CLASSIFY_TOP_K=20
CLASSIFY_PER_LANDMARK=3
CLASSIFY_THRESHOLD=0.8

CORS_ORIGINS=["http://localhost:3000"]
